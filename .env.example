# ============================================================
# DQ Rules Engine + Sampling Framework — environment configuration
# ============================================================
# Copy this file to `.env` (or set these as real environment variables /
# secrets in your deployment platform) and fill in the values for your
# environment. Nothing in this file is read directly by Python — it's a
# reference for what config/env_config.py, db/connection_factory.py,
# db/adapters.py, and utils/alert.py each look for. Never commit a real
# `.env` file; credentials belong in your secrets manager, not source
# control (see ONBOARDING.md for the recommended pattern).

# ------------------------------------------------------------
# Target environment (config/env_config.py)
# ------------------------------------------------------------
# One of DEV | QA | UAT | PROD — selects the CONFIG dict entry in
# config/env_config.py (META_DB name + {ENV} token substitution for
# db_pattern-style table references). Optional override below.
DQ_ENV=DEV

# Overrides the CONFIG-derived metadata schema name outright — use this
# if your schema doesn't follow the DEV/QA/PROD naming convention baked
# into config/env_config.py's CONFIG dict.
# DQ_META_DB=MY_CUSTOM_DQ_SCHEMA_T

# ------------------------------------------------------------
# Connections (db/connection_factory.py, db/adapters.py)
# ------------------------------------------------------------
# Comma-separated list of connection NAMEs. Each name gets its own
# DQ_<NAME>_TYPE + driver-specific vars below. Names are case-insensitive
# and become the "source_system" value rules/sampling configs reference.
DQ_CONNECTION_NAMES=teradata

# Which connection NAME is the metadata store (always Teradata in this
# repo's supported topology — see db/connection_factory.py's docstring).
DQ_META_CONNECTION=teradata

# --- Teradata (metadata store — required; also usable as a rule source) ---
DQ_TERADATA_TYPE=teradata
DQ_TERADATA_HOST=your-teradata-host.example.com
DQ_TERADATA_USER=svc_dq_engine
DQ_TERADATA_PASSWORD=change_me
DQ_TERADATA_LOGMECH=LDAP

# --- PostgreSQL / AWS Aurora (PostgreSQL-compatible) — optional ------------
# Add "claims_pg" (or any name you choose) to DQ_CONNECTION_NAMES above,
# then configure it with this prefix. Repeat per additional connection.
# DQ_CLAIMS_PG_TYPE=postgresql
# DQ_CLAIMS_PG_HOST=claims-aurora.cluster-xyz.us-east-1.rds.amazonaws.com
# DQ_CLAIMS_PG_PORT=5432
# DQ_CLAIMS_PG_DATABASE=claims
# DQ_CLAIMS_PG_USER=svc_dq_engine
# DQ_CLAIMS_PG_PASSWORD=change_me
# DQ_CLAIMS_PG_SSLMODE=prefer

# --- S3 landed files (Parquet/CSV) — DuckDB-over-S3 — optional ------------
# DQ_RAW_FILES_TYPE=s3
# DQ_RAW_FILES_REGION=us-east-1
# Access key/secret optional — omit both to use the instance/task IAM role.
# DQ_RAW_FILES_ACCESS_KEY_ID=
# DQ_RAW_FILES_SECRET_ACCESS_KEY=
# DQ_RAW_FILES_SESSION_TOKEN=
# DQ_RAW_FILES_ENDPOINT=

# --- Local CSV/Excel/TSV/Parquet files — optional --------------------------
# DQ_LOCAL_FILES_TYPE=file
# DQ_LOCAL_FILES_BASE_PATH=/data/inputs/

# --- Databricks SQL Warehouse — optional, uncatalogued for this instance --
# DQ_DATALAKE_TYPE=databricks
# DQ_DATALAKE_HOST=adb-1234.azuredatabricks.net
# DQ_DATALAKE_HTTP_PATH=/sql/1.0/warehouses/abc
# DQ_DATALAKE_TOKEN=dapi...
# DQ_DATALAKE_CATALOG=
# DQ_DATALAKE_SCHEMA=

# --- Microsoft SQL Server — optional, uncatalogued for this instance ------
# Requires the ODBC Driver for SQL Server installed on the host.
# DQ_ERP_SQL_TYPE=sqlserver
# DQ_ERP_SQL_HOST=erp-db.internal
# DQ_ERP_SQL_PORT=1433
# DQ_ERP_SQL_DATABASE=ERP
# DQ_ERP_SQL_USER=svc_dq_engine
# DQ_ERP_SQL_PASSWORD=change_me
# DQ_ERP_SQL_DRIVER=ODBC Driver 18 for SQL Server
# DQ_ERP_SQL_TRUST_CERT=yes
# DQ_ERP_SQL_TRUSTED_CONNECTION=no

# ------------------------------------------------------------
# Engine behavior (core/engine.py, core/executor.py)
# ------------------------------------------------------------
# Thread-pool size for concurrent rule execution (fix #10).
DQ_MAX_WORKERS=5

# If "true", pre-validation failures on any rule abort the whole run
# instead of just marking those rules invalid and continuing (fix #17).
DQ_PREVALIDATE_ABORT=false

# Hours after which a still-RUNNING run is presumed crashed and marked
# ABORTED on the next engine startup (fix #4).
DQ_STALE_RUN_HOURS=4

# Cap on how many failing rows get captured into dq_exceptions per rule
# per run (failed_records/failure_pct stay accurate beyond the cap — see
# core/executor.py's fix #1).
DQ_MAX_EXCEPTIONS=10000

# Batch size for exception-row bulk inserts.
DQ_EXCEPTION_CHUNK=500

# Retry attempts for transient source-DB errors (fix #9).
DQ_QUERY_MAX_RETRIES=3

# Python logging level for the whole engine.
DQ_LOG_LEVEL=INFO

# Write a static, immutable per-run HTML audit report automatically after
# every run (core/reporting.py::generate_report). Off by default so
# ad-hoc/local runs don't spam the report archive — see RETENTION.md for
# what to do with these once DQ_AUTO_AUDIT_REPORT=true is generating them.
DQ_AUTO_AUDIT_REPORT=false
DQ_AUDIT_REPORT_DIR=./dq_audit_reports

# ------------------------------------------------------------
# File-source adapters (db/adapters.py::FileAdapter)
# ------------------------------------------------------------
DQ_FILE_ENCODING=utf-8
DQ_MAX_FILE_SIZE_MB=500

# ------------------------------------------------------------
# entrypoints.py --schedule (APScheduler cron mode)
# ------------------------------------------------------------
# Path to the job-list JSON file — see schedule.json.example.
DQ_CRON_SCHEDULE_FILE=schedule.json

# ------------------------------------------------------------
# Alerting (utils/alert.py) — Microsoft Teams + SMTP email
# ------------------------------------------------------------
# Both channels are optional and independent — set either, both, or
# neither (send_alert() just skips whichever isn't configured). Per-route
# notification channels in dq_notification_routes (see ddl.sql) reuse
# these same SMTP settings via send_alert_to().
DQ_TEAMS_WEBHOOK_URL=

DQ_EMAIL_FROM=
DQ_EMAIL_TO=
DQ_EMAIL_PASSWORD=
DQ_SMTP_SERVER=smtp.office365.com
# ssl | starttls | none — determines the default DQ_SMTP_PORT (465/587/25)
# unless DQ_SMTP_PORT is set explicitly below.
DQ_EMAIL_SSL_MODE=starttls
# DQ_SMTP_PORT=587

# ------------------------------------------------------------
# AWS credentials (only needed if not using an instance/task IAM role)
# ------------------------------------------------------------
# Used by S3Adapter (db/adapters.py) for S3-backed source connections,
# and by boto3 if your deployment resolves credentials that way.
# AWS_DEFAULT_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
