# dev.env.example
# ------------------------------------------------------------------------
# Local development credentials for the Generic Rules Engine (gre/).
#
# Copy this file to `dev.env` (at the repo root, same level as this file)
# and fill in real values. `dev.env` is gitignored -- never commit it.
#
# gre/config.py loads dev.env automatically (via python-dotenv) the first
# time gre.config is imported, and sets these as normal process env vars.
# From there, db/adapters.py / db/connection_factory.py (unmodified,
# already part of this repo's dq_* engine) pick them up exactly as they
# would in a real deployment -- these are the SAME env var names
# TeradataAdapter.build() and ConnectionFactory already expect; nothing
# GRE-specific is invented here.
#
# Later this can pivot to AWS Secrets Manager (or similar) without
# touching db/adapters.py or db/connection_factory.py at all -- only
# gre/config.py::_load_env_file() would change, to populate these same
# env var names from Secrets Manager instead of this file.
# ------------------------------------------------------------------------

# Which named connections to bring up. GRE's metadata store defaults to
# the connection named "teradata" (see GRE_META_CONNECTION below) -- add
# more names here, comma-separated, if your rules also query other
# sources (each additional name needs its own DQ_<NAME>_* block below).
DQ_CONNECTION_NAMES=teradata

# ── teradata (GRE's metadata store, and the default rule source) ────────
DQ_TERADATA_TYPE=teradata
DQ_TERADATA_HOST=
DQ_TERADATA_USER=
DQ_TERADATA_PASSWORD=
DQ_TERADATA_LOGMECH=LDAP

# ── GRE-specific settings (all optional -- shown with their defaults) ───
# GRE_META_CONNECTION=teradata
# GRE_META_DB=CMSUNIV_FILELAND_DEV_T
# GRE_EXCEPTION_CHUNK=500
# GRE_MAX_EXCEPTIONS=10000
# GRE_QUERY_MAX_RETRIES=3
# GRE_ENV_FILE=dev.env
